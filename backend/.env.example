# Copy this file to .env and fill in real values before running the server.

# Port the Express server listens on
PORT=3000

# Shared secret — must match API_SECRET in extension/config.js
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FFT_API_SECRET=CHANGE_ME_BEFORE_DEPLOY

# Comma-separated list of instructor API keys for dashboard access
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INSTRUCTOR_KEYS=INSTRUCTOR_KEY_1,INSTRUCTOR_KEY_2

# Absolute or relative path to the SQLite database file
DB_PATH=./data/tracker.db

# Focus-lost count threshold before a session is flagged (default 3)
FOCUS_LOST_THRESHOLD=3

# Cumulative time-away threshold in milliseconds before a session is flagged (default 60000)
TIME_AWAY_THRESHOLD_MS=60000

# Allowed origin(s) for CORS (comma-separated). Use * only in development.
CORS_ORIGINS=http://localhost:3000
